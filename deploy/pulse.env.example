# Copy to /etc/pulse/pulse.env on the server (root:root, chmod 600). Never commit the real file.
# Generate both secrets ON THE SERVER:
#   echo "PULSE_ADMIN_TOKEN=sk_root_$(openssl rand -hex 24)"
#   echo "PULSE_VAULT_KEK=$(openssl rand -hex 32)"
PULSE_ADMIN_TOKEN=sk_root_CHANGE_ME
PULSE_VAULT_KEK=CHANGE_ME_64_HEX_CHARS

# Browser origins allowed on admin/query routes. The Studio is served from the same domain.
PULSE_CORS_ORIGINS=https://analytics.example.com
PULSE_PUBLIC_URL=https://analytics.example.com

# Public node: stop strangers creating organisations. The first account can still sign up
# (with the root token as setup code). Use PULSE_ALLOWED_EMAIL_DOMAINS=yourco.com for teammates.
PULSE_ALLOW_NEW_ORGS=false

RUST_LOG=info,slatedb=warn

# Optional: require `Authorization: Bearer <token>` on GET /metrics (recommended if /metrics is reachable off-host).
# PULSE_METRICS_TOKEN=CHANGE_ME_METRICS_TOKEN

# Optional: keep event data in an S3-compatible bucket instead of /var/lib/pulse/object_store.
# Metadata (pulse_meta.db) stays on local disk either way, so keep the backup job.
# PULSE_OBJECT_STORE_URL=s3://my-pulse-bucket
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=auto                                              # R2: auto; AWS: e.g. eu-central-1
# AWS_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com   # omit for AWS S3
