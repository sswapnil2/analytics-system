# Multi-stage source build for local Docker builds:
#   docker build -f Dockerfile.source -t pulse:local .
#   docker run -p 8080:8080 -v pulse_data:/data -e PULSE_ADMIN_TOKEN="sk_root_$(openssl rand -hex 24)" pulse:local

FROM node:22-bookworm-slim AS web-builder
WORKDIR /src/web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

FROM rust:1.88-bookworm AS rust-builder
WORKDIR /src
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates/ ./crates/
COPY sdks/ ./sdks/
RUN cargo build --release --locked -p pulse-node

FROM debian:bookworm-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --system --uid 10001 --home-dir /data pulse \
 && mkdir -p /data /opt/pulse/web && chown pulse:pulse /data
COPY --from=rust-builder --chown=root:root /src/target/release/pulse-node /opt/pulse/pulse-node
COPY --from=web-builder --chown=root:root /src/web/dist /opt/pulse/web/dist
COPY --chown=root:root LICENSE NOTICE /opt/pulse/
ENV PULSE_HOST=0.0.0.0 \
    PORT=8080 \
    PULSE_DATA_DIR=/data \
    PULSE_WEB_DIST_DIR=/opt/pulse/web/dist
USER pulse
VOLUME /data
EXPOSE 8080
ENTRYPOINT ["/opt/pulse/pulse-node", "--no-quic"]
